# ─────────────────────────────────────────────────────────────────────────────
# SecretaryAI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# REQUIRED vars (app will refuse to start if missing):
#   SECRET_KEY, SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   DATABASE_URL, ANTHROPIC_API_KEY
#
# All other vars are optional; their features are disabled when left empty.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=SecretaryAI
DEBUG=false

# Public URL of the frontend app (used for OAuth redirect responses).
# Set to your custom domain in production, e.g. https://app.yourcompany.com
# Leave empty to use the built-in default (https://app.secretaryai.com).
FRONTEND_URL=

# Secret key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Used for JWT signing AND token encryption. Must be at least 32 chars.
SECRET_KEY=replace-me-with-a-random-64-char-hex-string

# Separate key used ONLY to encrypt stored tokens (QuickBooks, Google,
# Microsoft, 2FA secrets). Strongly recommended — generate it the same way as
# SECRET_KEY, and it must be a different value. Safe to add to a running system:
# values encrypted earlier are still readable and are re-encrypted as they are
# next saved. To rotate later: move the current value to ENCRYPTION_KEY_PREVIOUS
# (comma-separated list) and put a new one here.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # bypasses RLS — keep secret!

# Direct Postgres connection string (for Alembic migrations)
DATABASE_URL=postgresql://postgres:<password>@db.your-project-id.supabase.co:5432/postgres

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# CLAUDE_MODEL pins the Sonnet-tier version used for interactive chat, weekly
# reports, and email drafts. Leave as the default unless you need to pin a
# specific release (e.g. claude-sonnet-4-5 for a staging environment).
# Haiku-tier tasks (intent classification, email triage, morning briefings) are
# always routed to claude-haiku-4-5-20251001 regardless of this setting.
CLAUDE_MODEL=claude-sonnet-4-6

# ── QuickBooks Online (OAuth 2.0) ─────────────────────────────────────────────
# Create an app at: https://developer.intuit.com/app/developer/qbo/docs/get-started
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://your-domain.com/auth/qbo/callback
INTUIT_ENVIRONMENT=production    # or: sandbox
# From the Intuit developer portal → Webhooks. QBO webhooks are rejected until set.
INTUIT_WEBHOOK_VERIFIER_TOKEN=

# ── QuickBooks Desktop (via Conductor) ────────────────────────────────────────
# https://docs.conductor.is/
CONDUCTOR_API_KEY=
# Secret Conductor sends in the X-Conductor-Secret header on webhook calls.
# Make up a long random value and enter the same one in Conductor's webhook
# settings. NOT the API key. Conductor webhooks are rejected until this is set.
CONDUCTOR_WEBHOOK_SECRET=
# The separately-installed local connector (connector/). Leave false: it needs
# your Conductor key on the machine it runs on, so it is for an operator-run
# server only, never for customers (they use the desktop app's wizard).
LOCAL_CONNECTOR_ENABLED=false

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Overridden to redis://redis:6379/0 inside Docker Compose
REDIS_URL=redis://localhost:6379/0

# ── SendGrid (morning briefings + weekly reports) ────────────────────────────
SENDGRID_API_KEY=SG....
FROM_EMAIL=secretary@yourdomain.com

# ── Google APIs (Gmail + Sheets) ──────────────────────────────────────────────
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# Required scopes: gmail.readonly, gmail.send, gmail.compose, spreadsheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# ── Microsoft / Outlook mail (OAuth 2.0) ──────────────────────────────────────
# Register an app at https://entra.microsoft.com → App registrations.
#   Supported account types: "any organizational directory and personal accounts"
#   Redirect URI (Web): https://your-api-domain.com/auth/outlook/callback
#   API permissions (delegated): offline_access, User.Read, Mail.ReadWrite, Mail.Send
# Set all three or none.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://your-domain.com/auth/outlook/callback
MS_TENANT=common

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# If Redis is unreachable, signed-in requests are refused (so a logged-out or
# removed user cannot get back in). Set true only if you prefer availability.
AUTH_FAIL_OPEN_ON_STORE_OUTAGE=false
# true = a new account must confirm its email before signing in.
# Requires SENDGRID_API_KEY (checked at startup).
REQUIRE_EMAIL_VERIFICATION=false

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# The paywall switch. true = product pages need an active subscription or the
# 14-day trial every new company gets. Refused at startup unless both Stripe
# keys above are set, so it can never block customers who have no way to pay.
BILLING_ENFORCED=false

# ── Computer Use — KEEP OFF in any shared/cloud deployment ───────────────────
# It drives the mouse and keyboard of the machine the backend runs on, with no
# per-step human approval. It is off unless set to true here.
COMPUTER_USE_ENABLED=false
COMPUTER_USE_MAX_STEPS=50

# ── OpenAI (optional — Whisper speech-to-text for mobile voice input) ────────
OPENAI_API_KEY=

# ── Web sign-in ───────────────────────────────────────────────────────────────
# The web app keeps its session in an httpOnly cookie when it is served from the
# same origin as this API (the default: frontend/nginx.conf forwards /api and
# /auth). If the web app is on a sibling subdomain (app.example.com +
# api.example.com), build it with VITE_SESSION_MODE=cookie and list its origin
# in CORS_ORIGINS. If it is on an unrelated site, it falls back to token mode.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use "*" to allow all (dev only).
CORS_ORIGINS=http://localhost:5173,https://app.secretaryai.com,http://localhost:8081,http://localhost:19006

# ── Push Notifications (Expo Push Notification Service) ───────────────────────
# No key needed — Expo's push service is used directly from the backend.

# ── Sentry (optional error tracking) ─────────────────────────────────────────
# Strongly recommended in production. Get your DSN at https://sentry.io
SENTRY_DSN=

# ── API Docs (optional, production) ──────────────────────────────────────────
# Set to a secret string to expose /docs behind X-Docs-Key header in production.
# Leave empty to disable /docs entirely when DEBUG=false.
DOCS_API_KEY=
